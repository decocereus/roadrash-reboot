{
  "name": "roadrash-reboot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "node scripts/verify.ts check",
    "check:css-comments": "node scripts/check-css-comments.ts",
    "check:roots": "node scripts/check-roots.ts",
    "check:rules": "node scripts/check-rules.ts",
    "check:typescript-only": "node scripts/check-typescript-only.ts",
    "dev": "alchemy dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:rules": "vitest run --config tools/oxlint/vitest.config.ts && vitest run scripts",
    "test": "vitest run",
    "typecheck": "tsrs --noEmit && pnpm -r --if-present typecheck",
    "verify": "node scripts/verify.ts"
  },
  "dependencies": {
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260918.1",
    "@effect/platform-node": "4.0.0",
    "@types/node": "26.4.1",
    "alchemy": "2.0.0-beta.83",
    "oxfmt": "0.67.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2004",
    "postcss": "8.5.29",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "ultracite": "7.10.8",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0"
}
