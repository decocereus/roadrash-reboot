{
  "name": "roadrash-reboot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "art:pull": "node tools/art/pull.ts",
    "art:stage": "node tools/art/stage.ts",
    "art:upload": "node tools/art/upload.ts",
    "build": "pnpm -r --if-present build",
    "check": "node scripts/verify.ts check",
    "check:action-pins": "node scripts/check-action-pins.ts",
    "check:workflow-runs": "node scripts/check-workflow-runs.ts",
    "check:art": "node scripts/check-art.ts",
    "check:css-comments": "node scripts/check-css-comments.ts",
    "check:dead": "knip --no-progress",
    "check:feature-map": "node scripts/check-feature-map.ts",
    "check:handling": "node tools/handling/hands-off.ts --check",
    "check:madrid": "node tools/madrid/stretch.ts --check",
    "check:perf": "node tools/perf/gate.ts --check",
    "check:renderer-imports": "node scripts/check-renderer-imports.ts",
    "check:roots": "node scripts/check-roots.ts",
    "check:rule-routes": "node scripts/check-rule-routes.ts",
    "check:rules": "node scripts/check-rules.ts",
    "check:save-format": "node scripts/check-save-format.ts",
    "check:size": "node scripts/check-size.ts",
    "check:typescript-only": "node scripts/check-typescript-only.ts",
    "dev": "alchemy dev",
    "effect:reference": "node scripts/setup-effect-reference.ts",
    "feature-map": "node scripts/write-feature-map.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:rules": "vitest run --config tools/oxlint/vitest.config.ts && vitest run scripts",
    "madrid": "node tools/madrid/generate.ts",
    "madrid:fit": "node tools/madrid/fit.ts",
    "madrid:stretch": "node tools/madrid/stretch.ts",
    "perf": "node tools/perf/gate.ts",
    "perf:gpu": "node tools/perf/gpu.ts",
    "replay:engines": "node tools/replay/engines.ts",
    "replay:record": "node apps/web/test/pilot-replay-record.ts",
    "road:test": "node tools/road-test/road-test.ts",
    "rooms:compare": "node tools/rooms/compare.ts",
    "rooms:fights": "node tools/rooms/fights.ts",
    "rooms:gate": "node tools/rooms/gate.ts",
    "rooms:lag": "node tools/rooms/lag.ts",
    "rooms:lifecycle": "node tools/rooms/lifecycle.ts",
    "rooms:load": "node tools/rooms/load.ts",
    "rooms:queue": "node tools/rooms/queue.ts",
    "rooms:race": "node tools/rooms/race.ts",
    "rooms:read": "node tools/rooms/read.ts",
    "rooms:replay": "node tools/rooms/replay.ts",
    "rooms:trace": "node tools/rooms/trace.ts",
    "test": "vitest run",
    "typecheck": "tsrs --noEmit && pnpm -r --if-present typecheck",
    "verify": "node scripts/verify.ts",
    "vimaan": "node tools/verify/vimaan.ts"
  },
  "dependencies": {
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260918.1",
    "@effect/platform-node": "4.0.0",
    "@racer/art": "workspace:*",
    "@racer/career": "workspace:*",
    "@racer/rooms": "workspace:*",
    "@racer/sim": "workspace:*",
    "@types/node": "26.4.1",
    "alchemy": "2.0.0-beta.83",
    "knip": "6.41.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2004",
    "postcss": "8.5.29",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "ultracite": "7.10.8",
    "vite": "8.3.2",
    "vitest": "5.0.0",
    "yaml": "2.9.1"
