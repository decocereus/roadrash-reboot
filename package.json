{
  "name": "roadrash-reboot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "dev": "alchemy dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck"
  },
  "dependencies": {
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260918.1",
    "@effect/platform-node": "4.0.0",
    "@oxlint/plugins": "1.86.0",
    "@types/node": "26.4.1",
    "alchemy": "2.0.0-beta.83",
    "oxfmt": "0.67.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "ultracite": "7.10.8",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0"
}
