{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["alchemy.run.ts", "scripts/*.ts"],
      "project": ["*.ts", "scripts/**/*.ts"],
      "typescript": true
    },
    "apps/rooms": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "typescript": true
    },
    "apps/web": {
      "entry": [
        "src/routes/**/*.{ts,tsx}",
        "src/**/*.test.ts",
        "test/**/*.test.ts",
        "test/bike-contact.ts",
        "test/cold-restore-worker.ts",
        "test/outline-sides.ts",
        "test/rider-shade.ts",
        "test/renderer-lifecycle.ts",
        "test/replay-bundle.ts"
      ],
      "ignoreDependencies": ["cloudflare"],
      "project": ["src/**/*.{ts,tsx,css}", "test/**/*.ts"],
      "typescript": true
    },
    "packages/*": {
      "includeEntryExports": true,
      "project": ["src/**/*.ts"],
      "typescript": true
    },
    "packages/telemetry": {
      "entry": ["test/**/*.test.ts"],
      "includeEntryExports": true,
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "typescript": true
    },
    "packages/ui": {
      "includeEntryExports": true,
      "project": ["src/**/*.{ts,tsx,css}"],
      "typescript": true
    },
    "tools/blender": {
      "entry": ["*.ts"],
      "project": ["*.ts"],
      "typescript": true
    },
    "tools/rooms": {
      "project": ["**/*.ts"],
      "typescript": true
    },
    "tools/oxlint": {
      "entry": ["anti-slop/index.ts", "rushline/index.ts", "test/**/*.test.ts"],
      "project": ["**/*.ts"],
      "typescript": true
    },
    "tools/perf": {
      "entry": [
        "gate.ts",
        "lobby.ts",
        "measure.ts",
        "node.ts",
        "road-life.ts",
        "room.ts",
        "session.ts",
        "snapshot.ts",
        "test/**/*.test.ts",
        "test/bench-lock-worker.ts"
      ],
      "project": ["**/*.ts"],
      "typescript": true
    },
    "tools/verify": {
      "entry": ["rushline.ts", "test/**/*.test.ts"],
      "project": ["**/*.ts"],
      "typescript": true
    },
    "tools/madrid": {
      "entry": ["generate.ts", "test/**/*.test.ts"],
      "project": ["**/*.ts"],
      "typescript": true
    },
    "tools/replay": {
      "entry": ["engines.ts"],
      "project": ["**/*.ts"],
      "typescript": true
    },
    "tools/road-test": {
      "entry": ["test/**/*.test.ts", "test/variant-plan.ts"],
      "project": ["**/*.ts"],
      "typescript": true
    },
    "tools/art": {
      "entry": ["test/**/*.test.ts"],
      "project": ["**/*.ts"],
      "typescript": true
    }
  }
}
